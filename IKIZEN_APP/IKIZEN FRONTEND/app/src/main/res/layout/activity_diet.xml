<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    tools:context=".DietActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Top Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_card"
                    android:src="@android:drawable/ic_media_previous"
                    android:padding="8dp"
                    app:tint="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 4 OF 8"
                    android:textColor="#1877F2"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toTopOf="@+id/progressBar"
                    app:layout_constraintStart_toEndOf="@id/btnBack"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textColor="#758494"
                    android:textSize="12sp"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toTopOf="@+id/progressBar"
                    app:layout_constraintEnd_toEndOf="parent"/>
                    
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="16dp"
                    android:progress="50"
                    android:progressTint="#1CA6A6"
                    android:progressBackgroundTint="#E0E5EC"
                    app:layout_constraintBottom_toBottomOf="@id/btnBack"
                    app:layout_constraintStart_toEndOf="@id/btnBack"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="How do you prefer to eat?"
                android:textColor="#0B132B"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your meal plans will only ever suggest food that fits these preferences."
                android:textColor="#758494"
                android:textSize="14sp" />

            <!-- Preference Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:columnCount="2"
                android:rowCount="3"
                android:useDefaultMargins="true">
                
                <LinearLayout
                    android:id="@+id/llDietVeg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_goal_card_selected"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivDietVegIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/btn_star" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1CA6A6"/>
                        <ImageView android:id="@+id/ivDietVegCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vegetarian" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/llDietVegan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_goal_card_unselected"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivDietVeganIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/btn_star" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView android:id="@+id/ivDietVeganCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" android:visibility="invisible" app:tint="#1877F2"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vegan" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDietEggetarian"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_goal_card_unselected"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivDietEggIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/btn_star" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView android:id="@+id/ivDietEggCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" android:visibility="invisible" app:tint="#1877F2"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eggetarian" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDietNonVeg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_goal_card_unselected"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivDietNonVegIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/btn_star" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView android:id="@+id/ivDietNonVegCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" android:visibility="invisible" app:tint="#1877F2"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Non-Vegetarian" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDietPesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_goal_card_unselected"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivDietPescIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/btn_star" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView android:id="@+id/ivDietPescCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" android:visibility="invisible" app:tint="#1877F2"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pescatarian" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/llDietCustom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_goal_card_unselected"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivDietCustomIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/btn_star" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView android:id="@+id/ivDietCustomCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" android:visibility="invisible" app:tint="#1877F2"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Custom" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>
            </GridLayout>

            <!-- Preferred cuisines -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Preferred cuisines"
                android:textColor="#0B132B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick as many as you enjoy"
                android:textColor="#758494"
                android:textSize="14sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Indian ✓" android:background="@drawable/bg_chip_selected" android:padding="12dp" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="South Indian" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="North Indian" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Asian" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mediterranean ✓" android:background="@drawable/bg_chip_selected_teal" android:padding="12dp" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Western" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            
            <!-- Meals per day -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Meals per day"
                android:textColor="#0B132B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 meals/day" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 meals/day" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4 meals/day ✓" android:background="@drawable/bg_chip_selected_teal" android:padding="12dp" android:textColor="#FFFFFF"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5+ meals/day" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>

            <!-- Foods I like -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Foods I like"
                android:textColor="#0B132B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="We'll build meals around these"
                android:textColor="#758494"
                android:textSize="14sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Paneer ✓" android:background="@drawable/bg_chip_selected_teal" android:padding="12dp" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lentils ✓" android:background="@drawable/bg_chip_selected_teal" android:padding="12dp" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Greek yogurt ✓" android:background="@drawable/bg_chip_selected_teal" android:padding="12dp" android:textColor="#FFFFFF"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Oats ✓" android:background="@drawable/bg_chip_selected_teal" android:padding="12dp" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bananas" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tofu" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Berries" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rice" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spinach" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chickpeas" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:layout_marginTop="16dp">
                <EditText android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_input_field" android:hint="Add your own favourite" android:paddingStart="16dp" android:paddingEnd="16dp"/>
                <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@android:drawable/ic_input_add" android:background="@drawable/bg_chip_selected_teal" android:layout_marginStart="8dp" android:padding="12dp" app:tint="@color/white"/>
            </LinearLayout>

            <!-- Foods I avoid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Foods I avoid"
                android:textColor="#0B132B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="These will be kept out of your plans"
                android:textColor="#758494"
                android:textSize="14sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fried food ✓" android:background="@drawable/bg_chip_selected_red" android:padding="12dp" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sugary drinks ✓" android:background="@drawable/bg_chip_selected_red" android:padding="12dp" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Red meat" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mushrooms" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bitter gourd" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Processed snacks" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            
        </LinearLayout>
    </ScrollView>

    <!-- Sticky Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#F4F7FB"
        app:layout_constraintBottom_toBottomOf="parent">
            
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinueDiet"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            android:text="Continue  &gt;"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textAllCaps="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
