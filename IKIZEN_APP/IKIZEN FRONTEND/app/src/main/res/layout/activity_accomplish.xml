<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    tools:context=".AccomplishActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Top Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_card"
                    android:src="@android:drawable/ic_media_previous"
                    android:padding="8dp"
                    app:tint="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 7 OF 8"
                    android:textColor="#1877F2"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toTopOf="@+id/progressBar"
                    app:layout_constraintStart_toEndOf="@id/btnBack"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="88%"
                    android:textColor="#758494"
                    android:textSize="12sp"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toTopOf="@+id/progressBar"
                    app:layout_constraintEnd_toEndOf="parent"/>
                    
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="16dp"
                    android:progress="88"
                    android:progressTint="#1CA6A6"
                    android:progressBackgroundTint="#E0E5EC"
                    app:layout_constraintBottom_toBottomOf="@id/btnBack"
                    app:layout_constraintStart_toEndOf="@id/btnBack"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="What do you want to accomplish?"
                android:textColor="#0B132B"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your coach protects time for what matters, not just workouts."
                android:textColor="#758494"
                android:textSize="14sp" />

            <GridLayout
                android:id="@+id/glAccomplish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:columnCount="2"
                android:rowCount="4"
                android:useDefaultMargins="true">
                
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_goal_card_unselected" android:orientation="vertical" android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_myplaces" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView android:id="@+id/ivCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2" android:visibility="gone"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Study" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_goal_card_selected" android:orientation="vertical" android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_recent_history" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2"/>
                        <ImageView android:id="@+id/ivCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2" android:visibility="visible"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Career" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_goal_card_unselected" android:orientation="vertical" android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_compass" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView android:id="@+id/ivCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2" android:visibility="gone"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Business" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_goal_card_selected" android:orientation="vertical" android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_crop" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2"/>
                        <ImageView android:id="@+id/ivCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2" android:visibility="visible"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Personal Development" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_goal_card_unselected" android:orientation="vertical" android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_camera" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView android:id="@+id/ivCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2" android:visibility="gone"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hobbies" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_goal_card_unselected" android:orientation="vertical" android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_directions" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView android:id="@+id/ivCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2" android:visibility="gone"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fitness" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_goal_card_unselected" android:orientation="vertical" android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_gallery" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView android:id="@+id/ivCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2" android:visibility="gone"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Creative Work" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_goal_card_unselected" android:orientation="vertical" android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_add" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView android:id="@+id/ivCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2" android:visibility="gone"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>
            </GridLayout>

            <!-- Hobbies & interests -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Hobbies &amp; interests"
                android:textColor="#0B132B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="These become trackable weekly time goals"
                android:textColor="#758494"
                android:textSize="14sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📖 Reading ✓" android:background="@drawable/bg_chip_selected" android:padding="12dp" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎮 Gaming" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎧 Music ✓" android:background="@drawable/bg_chip_selected" android:padding="12dp" android:textColor="#FFFFFF"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💻 Coding ✓" android:background="@drawable/bg_chip_selected" android:padding="12dp" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📷 Photography" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✏️ Drawing" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚽ Sports" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✈️ Travel" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎥 Content Creation" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧠 Learning" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="➕ Other" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>

            <!-- When are you most productive -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="When are you most productive?"
                android:textColor="#0B132B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/glProductive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="true">
                
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_goal_card_selected" android:orientation="vertical" android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_view" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2"/>
                        <ImageView android:id="@+id/ivCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2" android:visibility="visible"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Morning" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_goal_card_unselected" android:orientation="vertical" android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_camera" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#FFA000"/>
                        <ImageView android:id="@+id/ivCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2" android:visibility="gone"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Afternoon" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_goal_card_unselected" android:orientation="vertical" android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_gallery" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#FF5722"/>
                        <ImageView android:id="@+id/ivCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2" android:visibility="gone"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Evening" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_goal_card_unselected" android:orientation="vertical" android:padding="16dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/ivIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_compass" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#3F51B5"/>
                        <ImageView android:id="@+id/ivCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/presence_online" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="#1877F2" android:visibility="gone"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Night" android:textStyle="bold" android:textColor="#0B132B" android:layout_marginTop="12dp"/>
                </LinearLayout>
            </GridLayout>

            <!-- Your first personal goal -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Your first personal goal"
                android:textColor="#0B132B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Small, specific and daily works best"
                android:textColor="#758494"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="24dp">
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_chip_selected" android:src="@android:drawable/ic_menu_mylocation" android:padding="8dp" app:tint="@color/white"/>
                    <EditText android:id="@+id/etPersonalGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:background="@null" android:text="Study Python for 1 hour every day" android:textColor="#0B132B" android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="24dp">
                    <TextView android:id="@+id/tvGoal1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Read 20 pages daily" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/tvGoal2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Code for 1 hour" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/tvGoal3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Journal every night" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/tvGoal4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Walk 8,000 steps" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Sticky Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#F4F7FB"
        app:layout_constraintBottom_toBottomOf="parent">
            
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinueAccomplish"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            android:text="Continue  &gt;"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textAllCaps="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
