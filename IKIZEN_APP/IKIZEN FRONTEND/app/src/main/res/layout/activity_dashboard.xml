<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    tools:context=".DashboardActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Nutrition Summary Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_score_gradient"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvNutritionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TODAY'S TARGETS"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Main Calories Circle -->
                <ProgressBar
                    android:id="@+id/pbMainCalories"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:progressDrawable="@drawable/bg_ring_blue"
                    android:progressTint="#00E5FF"
                    android:progress="0"
                    android:rotation="-90"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/tvNutritionTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:src="@drawable/bg_ring_blue"
                    app:tint="#40FFFFFF"
                    app:layout_constraintStart_toStartOf="@id/pbMainCalories"
                    app:layout_constraintTop_toTopOf="@id/pbMainCalories"
                    app:layout_constraintBottom_toBottomOf="@id/pbMainCalories"
                    app:layout_constraintEnd_toEndOf="@id/pbMainCalories"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="@id/pbMainCalories"
                    app:layout_constraintEnd_toEndOf="@id/pbMainCalories"
                    app:layout_constraintTop_toTopOf="@id/pbMainCalories"
                    app:layout_constraintBottom_toBottomOf="@id/pbMainCalories">
                    
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_dialog_map" app:tint="@color/white" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tvMainCalories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2870" android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kcal Req." android:textColor="#B3FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Macros Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="32dp"
                    android:weightSum="3"
                    app:layout_constraintTop_toBottomOf="@id/pbMainCalories">

                    <!-- Protein -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Protein" android:textColor="#B3FFFFFF" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvMainProtein" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="145g" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                        <ProgressBar android:id="@+id/pbMainProtein" style="?android:attr/progressBarStyleHorizontal" android:layout_width="60dp" android:layout_height="4dp" android:progress="0" android:progressTint="#2ED573" android:layout_marginTop="8dp"/>
                    </LinearLayout>

                    <!-- Carbs -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Carbs" android:textColor="#B3FFFFFF" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvMainCarbs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="300g" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                        <ProgressBar android:id="@+id/pbMainCarbs" style="?android:attr/progressBarStyleHorizontal" android:layout_width="60dp" android:layout_height="4dp" android:progress="0" android:progressTint="#FFA502" android:layout_marginTop="8dp"/>
                    </LinearLayout>

                    <!-- Fat -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fat" android:textColor="#B3FFFFFF" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvMainFat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="80g" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                        <ProgressBar android:id="@+id/pbMainFat" style="?android:attr/progressBarStyleHorizontal" android:layout_width="60dp" android:layout_height="4dp" android:progress="0" android:progressTint="#FF4757" android:layout_marginTop="8dp"/>
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>



            <!-- Daily Progress Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">
                <TextView android:id="@+id/tvDailyTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily progress" android:textColor="#0B132B" android:textStyle="bold" android:textSize="18sp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Live against today's targets" android:textColor="#758494" android:textSize="14sp" android:layout_marginTop="4dp" app:layout_constraintTop_toBottomOf="@id/tvDailyTitle" app:layout_constraintStart_toStartOf="parent"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Details" android:textColor="#1877F2" android:textStyle="bold" android:textSize="14sp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Progress Bars Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="24dp">
                
                <!-- Calories -->
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <ImageView android:id="@+id/icFire" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_dialog_map" android:background="@drawable/bg_chip_unselected" android:backgroundTint="#FFF3E0" android:padding="8dp" app:tint="#F57C00" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calories" android:textColor="#0B132B" android:textStyle="bold" android:textSize="14sp" android:layout_marginStart="16dp" app:layout_constraintStart_toEndOf="@id/icFire" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@+id/pbCalories"/>
                    <TextView android:id="@+id/tvCaloriesProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,250 / 2,870 kcal" android:textColor="#758494" android:textSize="12sp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@+id/pbCalories"/>
                    <ProgressBar android:id="@+id/pbCalories" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="6dp" android:progress="43" android:progressTint="#FF5722" android:layout_marginStart="16dp" android:layout_marginTop="8dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toEndOf="@id/icFire" app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Protein -->
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
                    <ImageView android:id="@+id/icBowl" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_agenda" android:background="@drawable/bg_chip_unselected" android:backgroundTint="#E8F5E9" android:padding="8dp" app:tint="#43A047" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Protein" android:textColor="#0B132B" android:textStyle="bold" android:textSize="14sp" android:layout_marginStart="16dp" app:layout_constraintStart_toEndOf="@id/icBowl" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@+id/pbProtein"/>
                    <TextView android:id="@+id/tvProteinProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="86 / 145 g" android:textColor="#758494" android:textSize="12sp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@+id/pbProtein"/>
                    <ProgressBar android:id="@+id/pbProtein" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="6dp" android:progress="59" android:progressTint="#2ED573" android:layout_marginStart="16dp" android:layout_marginTop="8dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toEndOf="@id/icBowl" app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Carbs -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <ImageView
                        android:id="@+id/icCarbs"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_crop"
                        android:background="@drawable/bg_chip_unselected"
                        android:backgroundTint="#FFF3E0"
                        android:padding="8dp"
                        app:tint="#F57C00"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carbs"
                        android:textColor="#0B132B"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toEndOf="@id/icCarbs"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/pbDetailCarbs"/>
                    <TextView
                        android:id="@+id/tvDetailCarbs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 0 g"
                        android:textColor="#758494"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/pbDetailCarbs"/>
                    <ProgressBar
                        android:id="@+id/pbDetailCarbs"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:progress="0"
                        android:progressTint="#F57C00"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/icCarbs"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Fats -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <ImageView
                        android:id="@+id/icFat"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        android:background="@drawable/bg_chip_unselected"
                        android:backgroundTint="#FCE4EC"
                        android:padding="8dp"
                        app:tint="#D81B60"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fat"
                        android:textColor="#0B132B"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toEndOf="@id/icFat"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/pbDetailFat"/>
                    <TextView
                        android:id="@+id/tvDetailFat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 0 g"
                        android:textColor="#758494"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/pbDetailFat"/>
                    <ProgressBar
                        android:id="@+id/pbDetailFat"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:progress="0"
                        android:progressTint="#D81B60"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/icFat"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Recommendation Engine Sections -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Recommended for You"
                    android:textColor="#0B132B"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Based on your profile, goals, and diet"
                    android:textColor="#758494"
                    android:textSize="14sp" />

                <!-- Food Recommendations -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Suggested Meals"
                    android:textColor="#1877F2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:id="@+id/llRecommendedFood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="8dp"
                        android:paddingEnd="16dp"/>
                </HorizontalScrollView>

                <!-- Exercise Recommendations -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Suggested Exercises"
                    android:textColor="#F57C00"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:id="@+id/llRecommendedExercises"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="24dp"
                        android:paddingEnd="16dp"/>
                </HorizontalScrollView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="16dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <!-- Home (Selected) -->
        <LinearLayout android:id="@+id/llHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="40dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_compass" android:background="@drawable/bg_nav_icon_selected" android:padding="6dp" app:tint="@color/white"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textColor="#1877F2" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
        </LinearLayout>
        
        <!-- Exercises -->
        <LinearLayout android:id="@+id/llExercises" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_directions" app:tint="#A0AABF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Exercises" android:textColor="#A0AABF" android:textSize="10sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
        
        <!-- Food -->
        <LinearLayout android:id="@+id/llFood" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_agenda" app:tint="#A0AABF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Food" android:textColor="#A0AABF" android:textSize="10sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
        
        <!-- Mood -->
        <LinearLayout android:id="@+id/llMood" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_view" app:tint="#A0AABF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mood" android:textColor="#A0AABF" android:textSize="10sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
        
        <!-- Settings -->
        <LinearLayout android:id="@+id/llSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_preferences" app:tint="#A0AABF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textColor="#A0AABF" android:textSize="10sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
        
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
