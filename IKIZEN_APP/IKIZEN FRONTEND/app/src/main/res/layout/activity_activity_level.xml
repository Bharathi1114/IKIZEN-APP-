<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    tools:context=".ActivityLevelActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Top Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_card"
                    android:src="@android:drawable/ic_media_previous"
                    android:padding="8dp"
                    app:tint="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 3 OF 8"
                    android:textColor="#1877F2"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toTopOf="@+id/progressBar"
                    app:layout_constraintStart_toEndOf="@id/btnBack"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="38%"
                    android:textColor="#758494"
                    android:textSize="12sp"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toTopOf="@+id/progressBar"
                    app:layout_constraintEnd_toEndOf="parent"/>
                    
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="16dp"
                    android:progress="38"
                    android:progressTint="#1CA6A6"
                    android:progressBackgroundTint="#E0E5EC"
                    app:layout_constraintBottom_toBottomOf="@id/btnBack"
                    app:layout_constraintStart_toEndOf="@id/btnBack"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="How does your day usually move?"
                android:textColor="#0B132B"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Daily movement matters more than workouts alone — it shapes your calorie target."
                android:textColor="#758494"
                android:textSize="14sp" />

            <!-- Sliders Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:orientation="vertical">
                
                <!-- Daily steps -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily steps"
                        android:textColor="#0B132B"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:id="@+id/tvStepsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8,000"
                        android:textColor="#0B132B"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <SeekBar
                    android:id="@+id/sbSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="19000"
                    android:progress="7000"
                    android:progressTint="#1877F2"
                    android:thumbTint="#1877F2" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1,000"
                        android:textSize="12sp"
                        android:textColor="#758494"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20,000"
                        android:textSize="12sp"
                        android:textColor="#758494"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                
                <!-- Average sitting hours -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Average sitting hours"
                        android:textColor="#0B132B"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:id="@+id/tvSittingValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8 h"
                        android:textColor="#0B132B"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <SeekBar
                    android:id="@+id/sbSitting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="12"
                    android:progress="6"
                    android:progressTint="#FF8C00"
                    android:thumbTint="#1877F2" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2h"
                        android:textSize="12sp"
                        android:textColor="#758494"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14 h"
                        android:textSize="12sp"
                        android:textColor="#758494"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                
                <!-- Sleep duration -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sleep duration"
                        android:textColor="#0B132B"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:id="@+id/tvSleepValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7.5 h"
                        android:textColor="#0B132B"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <SeekBar
                    android:id="@+id/sbSleep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="14"
                    android:progress="7"
                    android:progressTint="#5C5CFF"
                    android:thumbTint="#1877F2" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 h"
                        android:textSize="12sp"
                        android:textColor="#758494"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="11 h"
                        android:textSize="12sp"
                        android:textColor="#758494"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <!-- Job type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Job type"
                android:textColor="#0B132B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                <TextView android:id="@+id/tvJobDesk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Desk job ✓" android:background="@drawable/bg_chip_selected" android:padding="12dp" android:textColor="#FFFFFF" android:layout_marginEnd="8dp" android:backgroundTint="#1CA6A6"/>
                <TextView android:id="@+id/tvJobStudent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Student" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/tvJobField" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Field work" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:id="@+id/tvJobPhysical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Physical work" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/tvJobShift" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shift work" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:id="@+id/tvJobNotWorking" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Not working now" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
            </LinearLayout>

            <!-- Daily Activity Level -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Daily activity level"
                android:textColor="#0B132B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose the description closest to a normal week"
                android:textColor="#758494"
                android:textSize="14sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                
                <LinearLayout android:id="@+id/llActivitySedentary" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_goal_card_unselected" android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <ImageView android:id="@+id/ivActivitySedentary" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_recent_history"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sedentary" android:textStyle="bold" android:textColor="#0B132B"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Little to no exercise, mostly seated" android:textSize="12sp" android:textColor="#758494"/>
                    </LinearLayout>
                    <RadioButton android:id="@+id/rbActivitySedentary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:clickable="false"/>
                </LinearLayout>
                
                <LinearLayout android:id="@+id/llActivityLightly" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_goal_card_unselected" android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <ImageView android:id="@+id/ivActivityLightly" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_directions"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lightly Active" android:textStyle="bold" android:textColor="#0B132B"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Light movement 1-2 days a week" android:textSize="12sp" android:textColor="#758494"/>
                    </LinearLayout>
                    <RadioButton android:id="@+id/rbActivityLightly" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:clickable="false"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/llActivityModerately" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_goal_card_selected" android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <ImageView android:id="@+id/ivActivityModerately" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="#1CA6A6"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Moderately Active" android:textStyle="bold" android:textColor="#0B132B"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Exercise 3-4 days a week" android:textSize="12sp" android:textColor="#758494"/>
                    </LinearLayout>
                    <RadioButton android:id="@+id/rbActivityModerately" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:buttonTint="#1877F2" android:clickable="false"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/llActivityVery" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_goal_card_unselected" android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <ImageView android:id="@+id/ivActivityVery" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_upload"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Very Active" android:textStyle="bold" android:textColor="#0B132B"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hard training 5-6 days a week" android:textSize="12sp" android:textColor="#758494"/>
                    </LinearLayout>
                    <RadioButton android:id="@+id/rbActivityVery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:clickable="false"/>
                </LinearLayout>
                
                <LinearLayout android:id="@+id/llActivityExtremely" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_goal_card_unselected" android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/ivActivityExtremely" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_gallery"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Extremely Active" android:textStyle="bold" android:textColor="#0B132B"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Athlete or physical job + training" android:textSize="12sp" android:textColor="#758494"/>
                    </LinearLayout>
                    <RadioButton android:id="@+id/rbActivityExtremely" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:clickable="false"/>
                </LinearLayout>
                
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Sticky Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#F4F7FB"
        app:layout_constraintBottom_toBottomOf="parent">
            
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinueActivityLevel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            android:text="Continue  &gt;"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textAllCaps="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
