<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    tools:context=".HealthActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Top Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_card"
                    android:src="@android:drawable/ic_media_previous"
                    android:padding="8dp"
                    app:tint="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 5 OF 8"
                    android:textColor="#1877F2"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toTopOf="@+id/progressBar"
                    app:layout_constraintStart_toEndOf="@id/btnBack"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="63%"
                    android:textColor="#758494"
                    android:textSize="12sp"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toTopOf="@+id/progressBar"
                    app:layout_constraintEnd_toEndOf="parent"/>
                    
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="16dp"
                    android:progress="63"
                    android:progressTint="#1CA6A6"
                    android:progressBackgroundTint="#E0E5EC"
                    app:layout_constraintBottom_toBottomOf="@id/btnBack"
                    app:layout_constraintStart_toEndOf="@id/btnBack"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Help iKizen understand your health."
                android:textColor="#0B132B"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Conditions and allergies are treated as hard constraints across every plan we build."
                android:textColor="#758494"
                android:textSize="14sp" />

            <!-- Green Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_info_green"
                android:orientation="horizontal"
                android:padding="16dp">
                
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_card"
                    android:src="@android:drawable/ic_secure"
                    android:padding="8dp"
                    app:tint="#1CA6A6" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Private &amp; encrypted. Health details are stored on your device profile, never shared or sold, and used only to filter recommendations."
                    android:textColor="#1CA6A6"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Health conditions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Do you have any health conditions?"
                android:textColor="#0B132B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select all that apply"
                android:textColor="#758494"
                android:textSize="14sp" />

            <!-- Condition Chips -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Diabetes" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="High Blood Pressure" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thyroid condition" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Heart condition" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Asthma" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Digestive issues" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="None ✓" android:background="@drawable/bg_chip_selected" android:padding="12dp" android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- Food allergies -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Food allergies"
                android:textColor="#0B132B"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="We will never suggest a meal containing these"
                android:textColor="#758494"
                android:textSize="14sp" />

            <!-- Allergy Chips -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nuts ✓" android:background="@drawable/bg_chip_selected_red" android:padding="12dp" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Peanuts" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dairy" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eggs" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gluten" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Seafood" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Soy" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/llLastAllergyRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="None" android:background="@drawable/bg_chip_unselected" android:padding="12dp" android:textColor="#0B132B"/>
            </LinearLayout>
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:layout_marginTop="16dp">
                <EditText android:id="@+id/etAddAllergy" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_input_field" android:hint="Add another allergy" android:paddingStart="16dp" android:paddingEnd="16dp"/>
                <ImageView android:id="@+id/btnAddAllergy" android:layout_width="56dp" android:layout_height="56dp" android:src="@android:drawable/ic_input_add" android:background="@drawable/bg_add_red" android:layout_marginStart="8dp" android:padding="16dp" app:tint="@color/white"/>
            </LinearLayout>

            <!-- Red Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_info_red"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active food constraints"
                    android:textColor="#F43F5E"
                    android:textStyle="bold"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvActiveConstraints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nuts — every meal card will carry a visible warning and these ingredients are excluded from AI meal plans."
                    android:textColor="#F43F5E"
                    android:textSize="13sp" />
            </LinearLayout>
            
            <!-- Grey Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_info_grey"
                android:orientation="horizontal"
                android:padding="16dp">
                
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="#758494" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="If you manage a medical condition, please review your plan with your doctor or a registered dietitian before making significant changes."
                    android:textColor="#758494"
                    android:textSize="12sp" />
            </LinearLayout>
            
        </LinearLayout>
    </ScrollView>

    <!-- Sticky Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#F4F7FB"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="iKizen provides wellness guidance and does not replace professional medical advice."
            android:textColor="#758494"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_gravity="center" />
            
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinueHealth"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            android:text="Continue  &gt;"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textAllCaps="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
