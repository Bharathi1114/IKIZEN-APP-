<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    tools:context=".AICoachActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="@drawable/bg_card"
            android:padding="8dp"
            app:tint="#0B132B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="iKizen AI Coach"
                android:textColor="#0B132B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personalized Lifestyle Engine"
                android:textColor="#758494"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVitalityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="88% Vitality"
            android:background="@drawable/bg_tag_teal"
            android:textColor="#004D40"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Main Scrollable Content -->
    <ScrollView
        android:id="@+id/svContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/llHeader"
        app:layout_constraintBottom_toTopOf="@id/llChatInputBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Persona Switcher -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipHolistic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌿 Holistic Coach"
                        android:background="@drawable/bg_chip_selected_teal"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipTrainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏋️ Fitness Trainer"
                        android:background="@drawable/bg_chip_unselected"
                        android:textColor="#0B132B"
                        android:textSize="12sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipNutritionist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥗 Nutritionist"
                        android:background="@drawable/bg_chip_unselected"
                        android:textColor="#0B132B"
                        android:textSize="12sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipMindfulness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧘 Zen Mentor"
                        android:background="@drawable/bg_chip_unselected"
                        android:textColor="#0B132B"
                        android:textSize="12sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Smart Insights Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_score_gradient"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvInsightsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI SMART INSIGHTS"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvPillarStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE STATUS"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvMainInsightTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="⚡ Protein Synthesis Window"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/tvInsightsTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvMainInsightDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Intake is well-paced for your primary goal. Target high-density amino acids in your upcoming meal to maintain lean mass."
                    android:textColor="#D1E8F2"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_marginTop="6dp"
                    app:layout_constraintTop_toBottomOf="@id/tvMainInsightTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Chat Stream Container -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conversation"
                android:textColor="#0B132B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/llChatStream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Chat Bubbles injected dynamically -->
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Quick Prompt Chips -->
    <HorizontalScrollView
        android:id="@+id/svQuickPrompts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:background="#F0F4F8"
        app:layout_constraintBottom_toTopOf="@id/llChatInputBar">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/promptAudit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Lifestyle Audit"
                android:background="@drawable/bg_card"
                android:textColor="#0B132B"
                android:textSize="11sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/promptDinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥗 Dinner Macros"
                android:background="@drawable/bg_card"
                android:textColor="#0B132B"
                android:textSize="11sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/promptWorkout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Low Energy Tweak"
                android:background="@drawable/bg_card"
                android:textColor="#0B132B"
                android:textSize="11sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/promptSleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😴 Sleep Protocol"
                android:background="@drawable/bg_card"
                android:textColor="#0B132B"
                android:textSize="11sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Input Bar -->
    <LinearLayout
        android:id="@+id/llChatInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/white"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Ask your AI coach anything..."
            android:textColor="#0B132B"
            android:textColorHint="#A0AABF"
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp" />

        <ImageView
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="@drawable/bg_chip_selected_teal"
            android:padding="12dp"
            android:layout_marginStart="8dp"
            app:tint="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
