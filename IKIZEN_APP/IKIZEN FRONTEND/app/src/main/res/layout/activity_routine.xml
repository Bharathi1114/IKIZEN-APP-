<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    tools:context=".RoutineActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Top Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_card"
                    android:src="@android:drawable/ic_media_previous"
                    android:padding="8dp"
                    app:tint="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 8 OF 8"
                    android:textColor="#1877F2"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toTopOf="@+id/progressBar"
                    app:layout_constraintStart_toEndOf="@id/btnBack"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="#758494"
                    android:textSize="12sp"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toTopOf="@+id/progressBar"
                    app:layout_constraintEnd_toEndOf="parent"/>
                    
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="16dp"
                    android:progress="100"
                    android:progressTint="#1CA6A6"
                    android:progressBackgroundTint="#E0E5EC"
                    app:layout_constraintBottom_toBottomOf="@id/btnBack"
                    app:layout_constraintStart_toEndOf="@id/btnBack"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Shape your daily routine"
                android:textColor="#0B132B"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your coach schedules workouts, meals and focus blocks around this timeline."
                android:textColor="#758494"
                android:textSize="14sp" />

            <!-- Timeline Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_timeline_container"
                android:orientation="vertical"
                android:padding="24dp">
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_recent_history" app:tint="#A0AABF"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A TYPICAL WEEKDAY" android:textColor="#A0AABF" android:textStyle="bold" android:textSize="12sp" android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Timeline items (Simulated with views for simplicity without complex recycler/list logic) -->
                
                <!-- 07:00 Wake Up -->
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
                    <TextView android:id="@+id/tvTime1" android:layout_width="48dp" android:layout_height="wrap_content" android:text="07:00" android:textStyle="bold" android:textColor="#0B132B" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <View android:id="@+id/dot1" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_add_red" android:backgroundTint="#F57C00" app:layout_constraintStart_toEndOf="@id/tvTime1" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:layout_marginStart="8dp"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toBottomOf="@id/dot1" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="@id/dot1" app:layout_constraintEnd_toEndOf="@id/dot1"/>
                    
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="wrap_content" android:background="@drawable/bg_timeline_card" android:padding="16dp" android:layout_marginStart="16dp" app:layout_constraintStart_toEndOf="@id/dot1" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
                        <TextView android:id="@+id/tvTitle1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wake Up" android:textColor="#0B132B" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Morning" android:textColor="#F57C00" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_tag_orange" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/tvTitle1" app:layout_constraintStart_toStartOf="parent"/>
                        <ImageView android:id="@+id/ivEdit1" android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_edit" app:tint="#A0AABF" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 07:30 Morning Routine -->
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/tvTime2" android:layout_width="48dp" android:layout_height="wrap_content" android:text="07:30" android:textStyle="bold" android:textColor="#0B132B" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <View android:id="@+id/line2_top" android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@+id/dot2" app:layout_constraintStart_toStartOf="@id/dot2" app:layout_constraintEnd_toEndOf="@id/dot2"/>
                    <View android:id="@+id/dot2" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_add_red" android:backgroundTint="#1CA6A6" app:layout_constraintStart_toEndOf="@id/tvTime2" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:layout_marginStart="8dp"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toBottomOf="@id/dot2" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="@id/dot2" app:layout_constraintEnd_toEndOf="@id/dot2"/>
                    
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="wrap_content" android:background="@drawable/bg_timeline_card" android:padding="16dp" android:layout_marginStart="16dp" app:layout_constraintStart_toEndOf="@id/dot2" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
                        <TextView android:id="@+id/tvTitle2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Morning Routine" android:textColor="#0B132B" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Routine" android:textColor="#00897B" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_tag_teal" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/tvTitle2" app:layout_constraintStart_toStartOf="parent"/>
                        <ImageView android:id="@+id/ivEdit2" android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_edit" app:tint="#A0AABF" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 08:00 Breakfast -->
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/tvTime3" android:layout_width="48dp" android:layout_height="wrap_content" android:text="08:00" android:textStyle="bold" android:textColor="#0B132B" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@+id/dot3" app:layout_constraintStart_toStartOf="@id/dot3" app:layout_constraintEnd_toEndOf="@id/dot3"/>
                    <View android:id="@+id/dot3" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_add_red" android:backgroundTint="#43A047" app:layout_constraintStart_toEndOf="@id/tvTime3" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:layout_marginStart="8dp"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toBottomOf="@id/dot3" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="@id/dot3" app:layout_constraintEnd_toEndOf="@id/dot3"/>
                    
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="wrap_content" android:background="@drawable/bg_timeline_card" android:padding="16dp" android:layout_marginStart="16dp" app:layout_constraintStart_toEndOf="@id/dot3" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
                        <TextView android:id="@+id/tvTitle3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Breakfast" android:textColor="#0B132B" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Meal" android:textColor="#43A047" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_tag_green" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/tvTitle3" app:layout_constraintStart_toStartOf="parent"/>
                        <ImageView android:id="@+id/ivEdit3" android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_edit" app:tint="#A0AABF" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 09:00 Study/Work -->
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/tvTime4" android:layout_width="48dp" android:layout_height="wrap_content" android:text="09:00" android:textStyle="bold" android:textColor="#0B132B" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@+id/dot4" app:layout_constraintStart_toStartOf="@id/dot4" app:layout_constraintEnd_toEndOf="@id/dot4"/>
                    <View android:id="@+id/dot4" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_add_red" android:backgroundTint="#1877F2" app:layout_constraintStart_toEndOf="@id/tvTime4" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:layout_marginStart="8dp"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toBottomOf="@id/dot4" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="@id/dot4" app:layout_constraintEnd_toEndOf="@id/dot4"/>
                    
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="wrap_content" android:background="@drawable/bg_timeline_card" android:padding="16dp" android:layout_marginStart="16dp" app:layout_constraintStart_toEndOf="@id/dot4" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
                        <TextView android:id="@+id/tvTitle4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Study / Work" android:textColor="#0B132B" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Deep work" android:textColor="#1877F2" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_tag_blue" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/tvTitle4" app:layout_constraintStart_toStartOf="parent"/>
                        <ImageView android:id="@+id/ivEdit4" android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_edit" app:tint="#A0AABF" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 13:00 Lunch -->
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/tvTime5" android:layout_width="48dp" android:layout_height="wrap_content" android:text="13:00" android:textStyle="bold" android:textColor="#0B132B" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@+id/dot5" app:layout_constraintStart_toStartOf="@id/dot5" app:layout_constraintEnd_toEndOf="@id/dot5"/>
                    <View android:id="@+id/dot5" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_add_red" android:backgroundTint="#43A047" app:layout_constraintStart_toEndOf="@id/tvTime5" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:layout_marginStart="8dp"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toBottomOf="@id/dot5" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="@id/dot5" app:layout_constraintEnd_toEndOf="@id/dot5"/>
                    
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="wrap_content" android:background="@drawable/bg_timeline_card" android:padding="16dp" android:layout_marginStart="16dp" app:layout_constraintStart_toEndOf="@id/dot5" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
                        <TextView android:id="@+id/tvTitle5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lunch" android:textColor="#0B132B" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Meal" android:textColor="#43A047" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_tag_green" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/tvTitle5" app:layout_constraintStart_toStartOf="parent"/>
                        <ImageView android:id="@+id/ivEdit5" android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_edit" app:tint="#A0AABF" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 17:30 Workout -->
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/tvTime6" android:layout_width="48dp" android:layout_height="wrap_content" android:text="17:30" android:textStyle="bold" android:textColor="#0B132B" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@+id/dot6" app:layout_constraintStart_toStartOf="@id/dot6" app:layout_constraintEnd_toEndOf="@id/dot6"/>
                    <View android:id="@+id/dot6" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_add_red" android:backgroundTint="#0B132B" app:layout_constraintStart_toEndOf="@id/tvTime6" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:layout_marginStart="8dp"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toBottomOf="@id/dot6" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="@id/dot6" app:layout_constraintEnd_toEndOf="@id/dot6"/>
                    
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="wrap_content" android:background="@drawable/bg_timeline_card" android:padding="16dp" android:layout_marginStart="16dp" app:layout_constraintStart_toEndOf="@id/dot6" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
                        <TextView android:id="@+id/tvTitle6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Workout" android:textColor="#0B132B" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Training" android:textColor="#0B132B" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_tag_darkblue" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/tvTitle6" app:layout_constraintStart_toStartOf="parent"/>
                        <ImageView android:id="@+id/ivEdit6" android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_edit" app:tint="#A0AABF" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 20:00 Dinner -->
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/tvTime7" android:layout_width="48dp" android:layout_height="wrap_content" android:text="20:00" android:textStyle="bold" android:textColor="#0B132B" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@+id/dot7" app:layout_constraintStart_toStartOf="@id/dot7" app:layout_constraintEnd_toEndOf="@id/dot7"/>
                    <View android:id="@+id/dot7" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_add_red" android:backgroundTint="#43A047" app:layout_constraintStart_toEndOf="@id/tvTime7" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:layout_marginStart="8dp"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toBottomOf="@id/dot7" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="@id/dot7" app:layout_constraintEnd_toEndOf="@id/dot7"/>
                    
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="wrap_content" android:background="@drawable/bg_timeline_card" android:padding="16dp" android:layout_marginStart="16dp" app:layout_constraintStart_toEndOf="@id/dot7" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
                        <TextView android:id="@+id/tvTitle7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dinner" android:textColor="#0B132B" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Meal" android:textColor="#43A047" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_tag_green" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/tvTitle7" app:layout_constraintStart_toStartOf="parent"/>
                        <ImageView android:id="@+id/ivEdit7" android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_edit" app:tint="#A0AABF" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 22:30 Wind Down -->
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/tvTime8" android:layout_width="48dp" android:layout_height="wrap_content" android:text="22:30" android:textStyle="bold" android:textColor="#0B132B" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@+id/dot8" app:layout_constraintStart_toStartOf="@id/dot8" app:layout_constraintEnd_toEndOf="@id/dot8"/>
                    <View android:id="@+id/dot8" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_add_red" android:backgroundTint="#8E24AA" app:layout_constraintStart_toEndOf="@id/tvTime8" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:layout_marginStart="8dp"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toBottomOf="@id/dot8" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="@id/dot8" app:layout_constraintEnd_toEndOf="@id/dot8"/>
                    
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="wrap_content" android:background="@drawable/bg_timeline_card" android:padding="16dp" android:layout_marginStart="16dp" app:layout_constraintStart_toEndOf="@id/dot8" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
                        <TextView android:id="@+id/tvTitle8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wind Down" android:textColor="#0B132B" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Free time" android:textColor="#8E24AA" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_tag_purple" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/tvTitle8" app:layout_constraintStart_toStartOf="parent"/>
                        <ImageView android:id="@+id/ivEdit8" android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_edit" app:tint="#A0AABF" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 23:00 Sleep -->
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp">
                    <TextView android:id="@+id/tvTime9" android:layout_width="48dp" android:layout_height="wrap_content" android:text="23:00" android:textStyle="bold" android:textColor="#0B132B" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <View android:layout_width="1dp" android:layout_height="0dp" android:background="#E0E5EC" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@+id/dot9" app:layout_constraintStart_toStartOf="@id/dot9" app:layout_constraintEnd_toEndOf="@id/dot9"/>
                    <View android:id="@+id/dot9" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_add_red" android:backgroundTint="#8E24AA" app:layout_constraintStart_toEndOf="@id/tvTime9" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:layout_marginStart="8dp"/>
                    
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="wrap_content" android:background="@drawable/bg_timeline_card" android:padding="16dp" android:layout_marginStart="16dp" app:layout_constraintStart_toEndOf="@id/dot9" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
                        <TextView android:id="@+id/tvTitle9" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sleep" android:textColor="#0B132B" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sleep" android:textColor="#8E24AA" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_tag_purple" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/tvTitle9" app:layout_constraintStart_toStartOf="parent"/>
                        <ImageView android:id="@+id/ivEdit9" android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_edit" app:tint="#A0AABF" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <!-- Blue Info Card -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_info_blue"
                android:padding="24dp"
                android:text="Based on this routine, your coach will place training at 17:30 and protect a focus block in the morning."
                android:textColor="#1877F2"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Sticky Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#F4F7FB"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Tap any moment to adjust the time or rename it."
            android:textColor="#A0AABF"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_gravity="center" />
            
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinueRoutine"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            android:text="See My Targets  &gt;"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textAllCaps="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

